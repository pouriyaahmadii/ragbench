# RAGBench - EditorConfig
# https://editorconfig.org
# Ensures consistent coding styles across editors and IDEs

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Python
[*.py]
indent_size = 4
max_line_length = 100

# TypeScript / JavaScript / JSON / YAML
[*.{ts,tsx,js,jsx,json,yaml,yml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Docker
[Dockerfile*]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# TOML (pyproject.toml, Cargo.toml)
[*.toml]
indent_size = 2

# CSS / SCSS
[*.{css,scss}]
indent_size = 2

# HTML
[*.html]
indent_size = 2