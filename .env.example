# RAGBench - Environment Configuration Template
# Copy to .env and fill in values. Never commit .env to Git.

# =============================================================================
# Application
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | console

# =============================================================================
# Mock Mode (Default for CI and Local Demo)
# When true, forces Mock providers regardless of other settings.
# =============================================================================
MOCK_MODE=true

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_DB=ragbench
POSTGRES_USER=ragbench
POSTGRES_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql+asyncpg://ragbench:changeme_secure_password@postgres:5432/ragbench

# =============================================================================
# Vector Store (Qdrant)
# =============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=  # Optional; set if Qdrant auth enabled

# =============================================================================
# Redis (Optional - Only if Celery Enabled via ADR-005)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Embedding Provider Configuration
# Provider: mock | ollama | openai | cohere
# =============================================================================
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock
EMBEDDING_VERSION=1.0
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_SECONDS=60

# Ollama Embedding (if provider=ollama)
OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI Embedding (if provider=openai)
OPENAI_API_KEY=  # Required if provider=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Cohere Embedding (if provider=cohere)
COHERE_API_KEY=  # Required if provider=cohere
COHERE_EMBEDDING_MODEL=embed-english-v3.0

# =============================================================================
# Generation Provider Configuration
# Provider: mock | ollama | openai | anthropic
# =============================================================================
GENERATION_PROVIDER=mock
GENERATION_MODEL=mock
GENERATION_VERSION=1.0
GENERATION_TEMPERATURE=0.0
GENERATION_MAX_TOKENS=1024
GENERATION_TIMEOUT_SECONDS=60

# Ollama Generation (if provider=ollama)
OLLAMA_GENERATION_URL=http://host.docker.internal:11434
OLLAMA_GENERATION_MODEL=llama3.1:8b

# OpenAI Generation (if provider=openai)
OPENAI_GENERATION_MODEL=gpt-4o-mini

# Anthropic Generation (if provider=anthropic)
ANTHROPIC_API_KEY=  # Required if provider=anthropic
ANTHROPIC_GENERATION_MODEL=claude-3-haiku-20240307

# =============================================================================
# Ingestion Limits
# =============================================================================
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARS=1000000
PARSER_TIMEOUT_SECONDS=30

# =============================================================================
# Chunking Configuration
# =============================================================================
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# =============================================================================
# Retrieval Configuration
# =============================================================================
DEFAULT_TOP_K=5
MAX_TOP_K=20

# =============================================================================
# Generation Context Limits
# =============================================================================
MAX_CONTEXT_CHARS=4000

# =============================================================================
# Frontend (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# =============================================================================
# Optional: Observability
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g., http://otel-collector:4318
OTEL_SERVICE_NAME=ragbench-api

# =============================================================================
# Optional: External Evaluation (Phase 16)
# =============================================================================
RAGAS_API_KEY=  # If using Ragas cloud
EVAL_JUDGE_PROVIDER=  # ragas | custom
EVAL_JUDGE_MODEL=  # e.g., gpt-4